# ─────────────────────────────────────────────
#  ar-output-YOLO  —  Environment Variables
# ─────────────────────────────────────────────
#  NEVER commit this file to git.
#  Copy this to .env and fill in your real values.
#  On Vercel: add these in Dashboard → Settings → Environment Variables

# ── LLM (NVIDIA Hosted Inference API) ────────
# Free tier available at: https://build.nvidia.com
# Sign in → top-right avatar → API Keys → Create API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Roboflow (YOLO object detection) ─────────
# Get your key at: https://app.roboflow.com → Settings → Roboflow API
# Click your workspace name (top-left) → API Keys → Copy Private API Key
ROBOFLOW_API_KEY=sCeSU3tBkqCWRttvc4p5

# ── HiveMQ MQTT Broker ────────────────────────
# Your HiveMQ Cloud credentials (Settings → Access Management)
MQTT_HOST=0f23b53beddd48cebc845a657cd08ab6.s1.eu.hivemq.cloud
MQTT_PORT=8884
MQTT_USERNAME=CodeAcces
MQTT_PASSWORD=CodeAcces1

# ─────────────────────────────────────────────
#  QWEN / OLLAMA NOTE
# ─────────────────────────────────────────────
#  Ollama runs LOCALLY — no API key needed.
#  Just run:  ollama run qwen2.5:3b
#
#  If you want the CLOUD Qwen API (via Alibaba DashScope):
#    1. Go to: https://dashscope.aliyuncs.com
#    2. Sign in with your Alibaba Cloud account
#    3. API Keys → Create Key
#    4. Model name: qwen-turbo  or  qwen-plus  or  qwen-max
#  DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
#  Note: the NVIDIA API also hosts Qwen models for free:
#    Model: qwen/qwen2.5-72b-instruct  (on integrate.api.nvidia.com)
#    Use your NVIDIA_API_KEY above — no separate Qwen key needed.
